# Defaults versionados para Escenario B: Elastic hibrido con EDoT.
SCENARIO=escenario_b
HOST=http://localhost:8080
USERS=50
SPAWN_RATE=5
RUN_TIME=10m
SAMPLE_INTERVAL=5
POST_RUN_SLEEP=30
OUT_ROOT=results
LOCUSTFILE=locustfile.py
CONTAINER_REGEX=api-gateway|room-service|user-service|reservation-service|notification-service|db|redis|edot-collector|elasticsearch|kibana|kibana-setup
ENGINE_URL=http://localhost:9200
ENGINE_USER=elastic
ENGINE_PASS=${ELASTIC_PASSWORD:-changeme}
ENGINE_INSECURE=false
PROMETHEUS_URL=
