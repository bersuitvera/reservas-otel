# Defaults versionados para Escenario A: OpenSearch OTel-native.
SCENARIO=escenario_a
HOST=http://localhost:8080
USERS=50
SPAWN_RATE=5
RUN_TIME=10m
SAMPLE_INTERVAL=5
POST_RUN_SLEEP=30
OUT_ROOT=results
LOCUSTFILE=locustfile.py
CONTAINER_REGEX=api-gateway|room-service|user-service|reservation-service|notification-service|db|redis|otel-collector|data-prepper|opensearch|prometheus|opensearch-dashboards|opensearch-exporter
ENGINE_URL=https://localhost:9200
ENGINE_USER=admin
ENGINE_PASS=ChangeMe_123!
ENGINE_INSECURE=true
PROMETHEUS_URL=http://localhost:9090
